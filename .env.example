# Peaks2Shores: environment variables.
# Copy this file to .env.local for local work, or set the variables in the
# host's project settings (Production and Preview). None is required to run the
# site; each one switches something on.

# -- Forms (server only: no NEXT_PUBLIC_ prefix, never sent to the browser) ----
# Where form submissions go: an https endpoint that accepts a JSON POST. It can
# be an automation webhook (Zapier, Make, n8n), a CRM's inbound endpoint, or a
# small function in front of a mailing provider. While a variable is empty,
# that form's submissions are stored nowhere, and the form says so.
# See src/lib/delivery.ts and docs/redesign/ARCHITECTURE.md, section 6.

# Journey and private-travel inquiries.
# Receives { "type": "enquiry", "submittedAt": "...", "data": { ... } }
ENQUIRY_WEBHOOK_URL=

# Circle (newsletter) sign-ups.
# Receives { "type": "subscription", "submittedAt": "...",
#            "data": { "email", "source", "page", "consent" } }
# The mailing provider behind this endpoint must run double opt-in (the form
# tells a new subscriber to confirm from their inbox) and put an unsubscribe
# link in every email.
SUBSCRIBE_WEBHOOK_URL=

# Optional. When set, each request carries the header
# X-Peaks2Shores-Signature: sha256=<hex HMAC-SHA256 of the request body>
FORMS_WEBHOOK_SECRET=

# -- Analytics (public by design) ----------------------------------------------
# Google Tag Manager container ID (GTM-XXXXXXX). While empty, no tag is loaded.
NEXT_PUBLIC_GTM_ID=
